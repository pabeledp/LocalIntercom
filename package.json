{
  "name": "local-intercom",
  "version": "1.0.0",
  "description": "Local Wi-Fi Floating Intercom & Giant File Streaming App",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && vite build",
    "dev": "vite",
    "start": "electron .",
    "dist": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.pabel.localintercom",
    "productName": "LocalIntercom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": "false",
      "gatekeeperAssess": "false",
      "identity": null
    }
  },
  "keywords": [],
  "author": "Pabel",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.6.0",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3",
    "ws": "^8.22.1"
  }
}
